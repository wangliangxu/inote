{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "iNote",
  "version": "0.9.0",
  "identifier": "com.local.inote",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "iNote",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620,
        "decorations": true,
        "visible": false,
        "theme": "Dark",
        "backgroundColor": "#050606",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 20
        }
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
